{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "types": ["expo/types", "node", "react"]
  },
  "include": ["App.jsx", "src/**/*.js", "src/**/*.jsx"],
  "exclude": ["node_modules", "android", "ios"]
}
