        <ownedAttribute xmi:id="attr_User_PasswordHash" name="PasswordHash" type="type_string"/>
        <ownedAttribute xmi:id="attr_User_FullName" name="FullName" type="type_string"/>
        <ownedAttribute xmi:id="attr_User_Phone" name="Phone" type="type_string"/>
        <ownedAttribute xmi:id="attr_User_Role" name="Role" type="enum_UserRole"/>
        <ownedAttribute xmi:id="attr_User_IsActive" name="IsActive" type="type_bool"/>
