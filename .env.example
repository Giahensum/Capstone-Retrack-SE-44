# Sao chép thành .env ở thư mục gốc. Đây là cấu hình Docker Compose, không dùng .env backend local.
# Hai giá trị bắt buộc bên dưới phải tự sinh; để trống để tránh chạy nhầm mật khẩu mẫu.
POSTGRES_PASSWORD=
JWT_KEY=
POSTGRES_DB=retrack
POSTGRES_USER=retrack
JWT_ISSUER=ReTrackAPI
JWT_AUDIENCE=ReTrackClient
PUBLIC_URL=http://localhost:8080
WEB_BIND_IP=127.0.0.1
WEB_PORT=8080
IMAGE_PREFIX=retrack
IMAGE_TAG=local
# Chỉ dùng khi chạy compose.https.yaml; PUBLIC_URL phải là https://DOMAIN tương ứng.
DOMAIN=
TLS_EMAIL=

# Khóa VITE_* là cấu hình công khai trong trình duyệt; giới hạn domain tại nhà cung cấp.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOONG_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Bật profile ai để chạy AI trong Compose, hoặc trỏ tới dịch vụ AI riêng.
AI_SERVICE_URL=http://ai:5005
AI_MODEL_DIR=./AI_Garbage_Classification/Pytorch-Garbage-Classification
AI_CPU_THREADS=2
