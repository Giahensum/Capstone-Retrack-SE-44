# Chỉ dùng khi phát triển. Sao chép thành .env rồi điền thông tin kết nối riêng trên máy.
# Biến môi trường của tiến trình được ưu tiên. Không thực thi biểu thức shell trong file này.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=Retrack_TV2_dev;Username=postgres;Password=CHANGE_ME
Jwt__Key=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES
Jwt__Issuer=ReTrack
Jwt__Audience=ReTrackUsers
Google__ClientId=
Google__ClientSecret=
Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=
Database__Initialize=false
Frontend__Url=http://localhost:5173

# PayOS (thanh toán thật) - lấy tại my.payos.vn > Kênh thanh toán. Tự điền, không commit.
PayOS__ClientId=
PayOS__ApiKey=
PayOS__ChecksumKey=
PayOS__ReturnUrl=http://localhost:5173/depot/payments/fees?payos=return
PayOS__CancelUrl=http://localhost:5173/depot/payments/fees?payos=cancel
# Backend tự hỏi PayOS mỗi N giây (5-600), không bắt buộc đăng ký webhook.
PayOS__PollSeconds=15
