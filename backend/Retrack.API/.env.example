# Chỉ dùng khi phát triển. Sao chép thành .env rồi điền thông tin kết nối riêng trên máy.
# Biến môi trường của tiến trình được ưu tiên. Không thực thi biểu thức shell trong file này.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=Retrack_TV2_dev;Username=postgres;Password=CHANGE_ME
Jwt__Key=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES
Jwt__Issuer=ReTrack
Jwt__Audience=ReTrackUsers
Google__ClientId=
Google__ClientSecret=
Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=
Database__Initialize=false
Frontend__Url=http://localhost:5173

# PayOS (thanh toán thật) - lấy tại my.payos.vn > Kênh thanh toán. Tự điền, không commit.
PayOS__ClientId=
PayOS__ApiKey=
PayOS__ChecksumKey=
PayOS__ReturnUrl=http://localhost:5173/depot/payments/fees?payos=return
PayOS__CancelUrl=http://localhost:5173/depot/payments/fees?payos=cancel
# Tùy chọn: URL quay về cho Factory (mặc định suy ra từ ReturnUrl, đường dẫn /factory)
# PayOS__FactoryReturnUrl=http://localhost:5173/factory?payos=return
# PayOS__FactoryCancelUrl=http://localhost:5173/factory?payos=cancel
# Backend tự hỏi PayOS mỗi N giây (5-600), không bắt buộc đăng ký webhook.
PayOS__PollSeconds=15
# payOS kênh CHI (Lệnh chi) - bộ khóa RIÊNG với kênh thu ở trên. Tự điền, không commit.
# PayOSPayout__ClientId=
# PayOSPayout__ApiKey=
# PayOSPayout__ChecksumKey=
# PayOSPayout__BaseUrl=https://api-merchant.payos.vn
# PayOSPayout__TimeoutSeconds=15
# Canonical (mặc định) hoặc RawJson. Cách ký chưa xác minh với payOS thật, xem Services/Money/README-payout-signature.md
# PayOSPayout__SignatureMode=Canonical
# Chi tiền qua sàn: nhà cung cấp chọn bằng cấu hình hệ thống payout.provider (Admin đổi trong màn hình Thu chi). Mặc định SIMULATED, chỉ chọn được PAYOS khi 3 khóa trên đã có.
# Worker chi tự động và đối soát (định dạng TimeSpan hh:mm:ss). Mặc định mỗi 1 phút; Enabled=false để tắt cả hai worker.
# Money__PayoutWorker__Enabled=true
# Money__PayoutWorker__AutoInterval=00:01:00
# Money__PayoutWorker__ReconcileInterval=00:01:00
# Money__PayoutWorker__ReconcileMinAge=00:01:00
# Money__PayoutWorker__ReconcileBatchSize=50
# Nhà cung cấp chi mô phỏng (demo): độ trễ giây và số dư giả lập
# Money__SimulatedPayoutDelaySeconds=5
# Money__SimulatedPayoutBalance=100000000
# Quét hồ sơ Depot: Disabled chỉ cho phép bỏ quét ở Development.
# Production chưa bật ClamAv sẽ từ chối nộp hồ sơ mới, không ảnh hưởng nghĩa vụ cũ.
VerificationScanner__Mode=Disabled
VerificationScanner__Host=127.0.0.1
VerificationScanner__Port=3310
VerificationScanner__TimeoutSeconds=10
# Chỉ demo: true = nhận hồ sơ kho KHÔNG quét mã độc khi Mode=Disabled ngoài Development. Mặc định false.
# VerificationScanner__AllowUnscannedForDemo=false
# Hồ sơ riêng tư: Database dùng byte DB, Cloudinary dùng raw/authenticated với account Cloudinary ở trên.
VerificationStorage__Provider=Database

# Vận chuyển lô: Disabled | Demo | LalamoveSandbox. Chỉ backend giữ key.
Shipping__Mode=Disabled
Shipping__InternalFactor=0.90
Shipping__MaxWeightKg=2500
Shipping__DemoStepSeconds=45
Shipping__ApiKey=
Shipping__ApiSecret=
# Mã service từ GET /v3/cities của tài khoản Sandbox, không tự đoán mã xe.
Shipping__ServiceType=
