# ═══════════════════════════════════════════════
# RETRACK — .gitignore
# ═══════════════════════════════════════════════

# ── Agent Skills (local reference only, không push) ──
.agent-skills/

# ── AI Context (local docs cho AI agent, không push) ──
.ai-context/
.claude/
# Worktree cục bộ nằm trong repo, không đưa nội dung checkout lồng vào Git.
.worktrees/

# ── Backend (.NET) ──
backend/**/bin/
backend/**/obj/
backend/**/*.user
backend/**/*.suo
backend/**/.vs/
backend/**/appsettings.Development.json
backend/**/.env
backend/**/.env.local
backend/**/TestResults/
backend/**/appsettings.json
backend/**/appsettings.*.json
!backend/**/appsettings.example.json
# Fixture dữ liệu riêng trên máy, không dùng làm seed chia sẻ.
backend/seed_test_data.sql
# Bản seed kho TP.HCM cũ chỉ giữ local trong .ai-context.
db/seed_more_depots.sql
be/**/bin/
be/**/obj/
be/**/*.user
be/**/*.suo
be/**/.vs/
be/**/appsettings.Development.json

# ── Frontend (React/Vite) ──
frontend/node_modules/
frontend/dist/
frontend/test-results/
frontend/.env
frontend/.env.local
frontend/.env.*.local
fe/node_modules/
fe/dist/
fe/.env
fe/.env.local
fe/.env.*.local

# ── IDE ──
mobile/node_modules/
mobile/.expo/
mobile/dist/
mobile/.env
mobile/android/
mobile/ios/

.vs/
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ──
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ──
*.log
npm-debug.log*

# ── Misc ──
**/.env
**/.env.*
!**/.env.example
**/TestResults/
**/coverage/
**/playwright-report/
*.trx
*.pfx
*.p12
*.pem
*.key
*.tmp
*.bak

# Bản sao giao diện Depot giữ local để đối chiếu, không đưa vào build/lint/Git.
frontend/src/features/depot/*_old*.jsx
backend/Retrack.API/uploads/
