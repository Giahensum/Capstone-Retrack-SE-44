# ═══════════════════════════════════════════════
# RETRACK — .gitignore
# ═══════════════════════════════════════════════

# ── Agent Skills (local reference only, không push) ──
.agent-skills/

# ── AI Context (local docs cho AI agent, không push) ──
.ai-context/
.claude/

# ── Backend (.NET) ──
backend/**/bin/
backend/**/obj/
backend/**/*.user
backend/**/*.suo
backend/**/.vs/
backend/**/appsettings.Development.json
be/**/bin/
be/**/obj/
be/**/*.user
be/**/*.suo
be/**/.vs/
be/**/appsettings.Development.json

# ── Frontend (React/Vite) ──
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/.env.*.local
fe/node_modules/
fe/dist/
fe/.env
fe/.env.local
fe/.env.*.local

# ── IDE ──
mobile/node_modules/
mobile/.expo/
mobile/dist/
mobile/.env
mobile/android/
mobile/ios/

.vs/
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ──
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ──
*.log
npm-debug.log*

# ── Misc ──
*.tmp
*.bak
