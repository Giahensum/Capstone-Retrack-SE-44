\set ON_ERROR_STOP on

\if :{?dbname}
\else
    \echo "Thiếu tên database. Chạy: psql -v dbname=Retrack_Team -U postgres -d postgres -f db/bootstrap.psql"
    \quit 2
\endif

-- Tạo DB nếu chưa tồn tại; không xóa hoặc thay thế database đã có.
SELECT format('CREATE DATABASE %I', :'dbname')
WHERE NOT EXISTS (SELECT 1 FROM pg_database WHERE datname = :'dbname')
\gexec

\connect :dbname

-- Chỉ bootstrap database rỗng. Với DB đang dùng, chạy quy trình nâng cấp đã review.
DO $$
BEGIN
    IF EXISTS (
        SELECT 1
        FROM pg_catalog.pg_tables
        WHERE schemaname = 'public'
    ) THEN
        RAISE EXCEPTION 'Database % đã có bảng trong schema public. Không chạy bootstrap; dùng quy trình nâng cấp DB hiện có.', current_database();
    END IF;
END
$$;

\ir 'depot ower/retrack-system.sql'
\ir 'retrack-demo-seed.sql'

\echo "Bootstrap hoàn tất: schema ReTrack và seed demo đã được nạp."
