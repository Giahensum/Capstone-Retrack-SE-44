# Cấu hình công khai của trình duyệt; không đặt secret backend tại đây.
# Local: sao chép thành frontend/.env.local rồi điền giá trị của nhóm.
# Vercel: nhập từng biến tại Project > Settings > Environment Variables.
VITE_GOOGLE_CLIENT_ID=
VITE_GOONG_API_KEY=

# Axios hiện gọi /api, không đọc VITE_API_URL.
# Local dùng server.proxy trong vite.config.js; Vercel dùng vercel.json.
# Đổi backend local qua biến môi trường PowerShell trước npm run dev:
# $env:API_PROXY_TARGET = 'http://localhost:5000'
# Không cần đặt API_PROXY_TARGET trên Vercel.
